// EX 603 — Game Telemetry Database (Theme 3)
// Updated in Unit 2 to match schema/schema.sql:
//   - game_modes.parent_mode_id recursive FK added
//   - all keys INTEGER identity, all timestamps TIMESTAMP (course type mapping)

Table players {
  player_id    int         [pk, increment]
  display_name varchar(50) [not null, note: 'CHECK: not blank']
  created_at   timestamp   [not null, default: `CURRENT_TIMESTAMP`]
}

Table game_modes {
  game_mode_id   int         [pk, increment]
  mode_name      varchar(50) [not null, unique, note: 'CHECK: not blank']
  parent_mode_id int         [null, note: 'NULL = top-level mode; CHECK: <> game_mode_id']
}

Table matches {
  match_id     int          [pk, increment]
  match_label  varchar(100) [not null]
  is_active    boolean      [not null, default: true]
  duration_sec int          [note: 'NULL while active; >= 0 once completed']
  started_at   timestamp    [not null, default: `CURRENT_TIMESTAMP`]
}

Table match_modes {
  match_id     int [not null]
  game_mode_id int [not null]

  indexes {
    (match_id, game_mode_id) [pk]
  }
}

Table match_participants {
  match_id  int       [not null]
  player_id int       [not null]
  score     int       [not null, note: 'CHECK: score >= 0']
  played_at timestamp [not null]

  indexes {
    (match_id, player_id) [pk]
  }
}

// Relationships (with ON DELETE behavior)
Ref: match_participants.match_id  > matches.match_id          [delete: cascade]
Ref: match_participants.player_id > players.player_id         [delete: restrict]
Ref: match_modes.match_id         > matches.match_id          [delete: cascade]
Ref: match_modes.game_mode_id     > game_modes.game_mode_id   [delete: restrict]
Ref: game_modes.parent_mode_id    > game_modes.game_mode_id   [delete: restrict]
